rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Kiểm tra quyền Admin/Staff an toàn, không gây lỗi khi document user chưa tồn tại hoặc token không có claim role
    function isStaffOrAdmin() {
      return isSignedIn() && (
        'role' in request.auth.token && (
          request.auth.token.role == 'admin' ||
          request.auth.token.role == 'staff'
        )
      );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isStaffOrAdmin();

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isStaffOrAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }

    match /order_idempotency/{key} {
      allow read, write: if isSignedIn();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /favorites/{favoriteId} {
      allow read, write: if isSignedIn();
    }

    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    match /inventory_transactions/{txId} {
      allow read, create: if isSignedIn();
    }
  }
}